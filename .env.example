# Combined deployment: configure these in AntiDeploy, then redeploy the project root.
# Replace this placeholder with your Gemini key; keep it out of frontend variables.
GEMINI_API_KEY=your-gemini-api-key
FRONTEND_ORIGINS=https://datastraw-assessment-ai-voice-agent.antideploy.app
NEXT_PUBLIC_API_URL=/api
TEST_API_URL=https://datastraw-assessment-ai-voice-agent.antideploy.app/api
TEST_BASE_URL=https://datastraw-assessment-ai-voice-agent.antideploy.app
LLM_MODEL=gemini-3.5-flash-lite
STT_MODEL=gemini-3.5-flash-lite
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
MAX_SESSIONS=8
