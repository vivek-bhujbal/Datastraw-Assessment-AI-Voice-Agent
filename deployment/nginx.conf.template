worker_processes 1;
pid /tmp/aura-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    access_log /dev/stdout;
    client_body_temp_path /tmp/aura-client;
    proxy_temp_path /tmp/aura-proxy;
    fastcgi_temp_path /tmp/aura-fastcgi;
    uwsgi_temp_path /tmp/aura-uwsgi;
    scgi_temp_path /tmp/aura-scgi;
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    server {
        listen __PORT__;
        server_name _;
        client_max_body_size 5m;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 960s;
        proxy_send_timeout 960s;

        location /api/ {
            # The trailing slash removes /api/ before forwarding to FastAPI.
            proxy_pass http://127.0.0.1:__BACKEND_PORT__/;
            proxy_buffering off;
        }
        location / {
            proxy_pass http://127.0.0.1:__FRONTEND_PORT__;
        }
    }
}
